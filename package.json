{
  "name": "root",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "preinstall": "npx -y only-allow npm",
    "prepare": "simple-git-hooks",
    "test": "lerna run test --ignore example-*",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:contracts",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "typecheck:contracts": "tsc --noEmit -p type-tests/tsconfig.json",
    "build": "lerna run build --ignore example-*",
    "check:examples": "npm run typecheck -w example-react && npm run build -w example-react",
    "test:packed": "node scripts/test-packed-packages.mjs",
    "release": "npm run release:check",
    "release:check": "npm run release:source && npm run release:artifacts",
    "release:source": "npm run lint && npm run typecheck && npm test",
    "release:artifacts": "npm run build && npm run release:postbuild",
    "release:postbuild": "npm run lint && npm run check:examples && npm run test:packed",
    "dev": "lerna run build:dev && lerna watch --ignore example-* -- lerna run build:dev",
    "prettier": "prettier **/* --write --ignore-unknown",
    "prepublishOnly": "npm run release:check",
    "publish": "lerna publish --no-private"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "18.2.35",
    "@types/react-dom": "18.2.14",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.53.0",
    "eslint-config-alloy": "^5.1.2",
    "eslint-plugin-react": "^7.33.2",
    "jsdom": "^22.1.0",
    "lerna": "^7.4.2",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-git-hooks": "^2.9.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6",
    "cross-env": "^7.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "volta": {
    "node": "20.9.0",
    "npm": "10.2.3"
  },
  "dependencies": {}
}
