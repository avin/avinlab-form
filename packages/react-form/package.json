{
  "name": "@avinlab/react-form",
  "type": "module",
  "version": "0.4.0",
  "description": "React bindings for @avinlab/form with concurrent-safe selective subscriptions.",
  "author": "Avin Lambrero <avin.github@gmail.com> (https://github.com/avin/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avin/avinlab-form.git",
    "directory": "packages/react-form"
  },
  "homepage": "https://github.com/avin/avinlab-form#readme",
  "bugs": {
    "url": "https://github.com/avin/avinlab-form/issues"
  },
  "keywords": [
    "form",
    "react"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "cross-env MODE=prod tsup",
    "build:dev": "cross-env MODE=dev tsup",
    "test": "npm run typecheck && vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@avinlab/form": "^0.4.0",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "98b2452f398fc913cbc6c0fa6a7183e73d9760d7",
  "devDependencies": {
    "@types/use-sync-external-store": "^1.5.0"
  }
}
