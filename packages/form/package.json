{
  "name": "@avinlab/form",
  "type": "module",
  "version": "0.5.0-alpha.0",
  "description": "Stable form controller with readonly snapshots and selective subscriptions.",
  "author": "Avin Lambrero <avin.github@gmail.com> (https://github.com/avin/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avin/avinlab-form.git",
    "directory": "packages/form"
  },
  "homepage": "https://github.com/avin/avinlab-form#readme",
  "bugs": {
    "url": "https://github.com/avin/avinlab-form/issues"
  },
  "keywords": [
    "form"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "cross-env MODE=prod tsup",
    "build:dev": "cross-env MODE=dev tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dequal": "^2.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "f7b4c8329726d1d4bdb2c7dd8d9c20b66fd80cdc"
}
